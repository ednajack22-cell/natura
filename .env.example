# Public site origin. Feeds sitemap.xml, robots.txt, feed.xml, llms.txt and
# metadataBase. Getting this wrong publishes localhost URLs to Google.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Locally these come from `pnpm supabase:status`; in production from
# the hosted project's API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key-from-supabase-status

# AdSense publisher id, e.g. ca-pub-1234567890123456.
# Leave empty locally: with no id the ad slots render an inert placeholder that
# reserves identical space, no third-party script loads, and the strict
# Content-Security-Policy stays in force. Setting it in production enables the
# ad tag, the generated /ads.txt, and Google's certified consent message.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# AdSense ad unit ids (Ads > By ad unit). A placement left empty keeps its
# reserved placeholder, so units can be switched on one at a time.
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
