{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Natura theme preview",
    "description": "Installs the Natura theme and the Natura Core plugin from the work-in-progress branch, with demo plant guides.",
    "author": "natura"
  },
  "landingPage": "/plants/cherry-tomato/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Natura",
        "blogdescription": "Grow with confidence",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/ednajack22-cell/natura",
        "ref": "claude/site-design-ux-analysis-2hwbga",
        "refType": "branch",
        "path": "wordpress/natura"
      },
      "options": {
        "activate": true,
        "targetFolderName": "natura"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/ednajack22-cell/natura",
        "ref": "claude/site-design-ux-analysis-2hwbga",
        "refType": "branch",
        "path": "wordpress/natura-core"
      },
      "options": {
        "activate": true,
        "targetFolderName": "natura-core"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; natura_core_import_demo( 'https://raw.githubusercontent.com/ednajack22-cell/natura/claude/site-design-ux-analysis-2hwbga/public/images' );"
    }
  ]
}
